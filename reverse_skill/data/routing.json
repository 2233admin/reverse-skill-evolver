    "active-security-assessment": [
      {
        "phase": "discovery",
        "purpose": "在授权范围内进行最小服务识别",
        "execution": "cli_via_skill",
        "when_any": [
          "nmap",
          "port scan",
          "service discovery",
          "端口扫描"
        ],
        "tools": [
          "nmap"
        ]
      },
      {
        "phase": "intercept",
        "purpose": "使用已启用的代理 MCP 记录请求证据",
        "execution": "mcp",
        "when_any": [
          "burp",
          "intercept",
          "proxy"
