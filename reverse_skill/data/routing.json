  },
  "macro_routes": [
    {
      "id": "apk-android",
      "target_kinds": [
        "apk",
        "android",
        "xapk",
        "dex",
        "smali"
      ],
      "intent_keywords": [
        "decompile",
        "repack",
        "smali",
        "frida",
        "ssl pinning",
        "signature bypass",
        "root detection"
      ],
      "primary_skill": "apk-reverse/SKILL.md",
      "requires_capabilities": [
        "jadx",
        "apktool"
      ],
      "fallback_edges": [
        {
          "when": "native_validation_detected",
          "goto": "ida-reverse/SKILL.md"
        },
        {
          "when": "cli_only_or_ida_missing",
          "goto": "radare2/SKILL.md"
        },
        {
          "when": "dynamic_verification_needed",
          "goto": "reverse-engineering/tools-dynamic.md"
        }
      ],
      "success_oracles": [
        "decoded_artifact_exists",
        "target_function_labeled",
        "replay_or_bypass_verified"
      ]
    },
    {
      "id": "js-browser-signature",
      "target_kinds": [
        "js_bundle",
        "web_frontend",
        "browser_runtime",
        "sourcemap"
      ],
      "intent_keywords": [
        "signature",
        "encrypted params",
        "js reverse",
        "request replay",
        "websocket"
      ],
      "primary_skill": "js-reverse/SKILL.md",
      "requires_capabilities": [
        "node",
        "npx"
      ],
      "fallback_edges": [
        {
          "when": "runtime_observation_needed",
          "goto": "browser-automation/SKILL.md"
        },
        {
          "when": "hook_or_cdp_needed",
          "goto": "jshookmcp"
        }
      ],
      "success_oracles": [
        "entry_function_identified",
        "local_replay_matches_browser"
      ]
    },
    {
      "id": "workspace-search",
      "target_kinds": [
        "workspace_search",
        "source_search",
        "code_search"
      ],
      "intent_keywords": [
        "workspace search",
        "code search",
        "search files",
        "ripgrep",
        "xcmd",
        "x rg",
        "搜索代码",
        "搜索工作区"
      ],
      "primary_skill": "reverse-engineering/SKILL.md",
      "requires_capabilities": [
        "rg"
      ],
      "fallback_edges": [],
      "success_oracles": [
        "search_results_recorded",
        "search_engine_health_recorded",
        "source_workspace_unchanged"
      ]
    },
    {
      "id": "native-binary",
      "target_kinds": [
        "elf",
        "pe",
        "dll",
        "so",
        "macho",
        "stripped_binary"
      ],
      "intent_keywords": [
        "ida",
        "disassemble",
        "decompile",
        "function map",
        "strings",
        "xref",
        "pathfinder",
        "dyld",
        "git-ida",
        "ida teams"
      ],
      "primary_skill": "ida-reverse/SKILL.md",
      "requires_capabilities": [
        "idapro"
      ],
      "fallback_edges": [
        {
          "when": "idapro_unavailable",
          "goto": "radare2/SKILL.md"
        },
        {
          "when": "ghidra_available_and_ida_missing",
          "goto": "reverse-engineering/SKILL.md",
          "requires_capabilities": [
            "analyzeHeadless"
          ]
        },
        {
          "when": "exploitability_needed",
          "goto": "pwn-chain/SKILL.md"
        }
      ],
      "success_oracles": [
        "target_function_labeled",
        "control_flow_evidence_recorded"
      ]
    },
    {
      "id": "patch-diff",
      "target_kinds": [
        "two_versions",
        "vendor_patch",
        "nday",
        "cve_reproduction"
      ],
      "intent_keywords": [
        "patch diff",
        "bindiff",
        "ghidriff",
        "symbol migration",
        "root cause"
      ],
      "primary_skill": "binary-diff/SKILL.md",
      "requires_capabilities": [
